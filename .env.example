# ── Frontend (Vite only exposes variables prefixed with VITE_) ────────────────
# These values are public. Never put service-account data or device tokens here.
VITE_FIREBASE_DATABASE_URL=https://dropsafe-5cd7c-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_BAG_ID=IV-01
VITE_FIREBASE_DEVICE_ID=dropsafe-01
# Auto-subscribe to the Realtime Database when the dashboard loads.
VITE_FIREBASE_AUTO_CONNECT=true
# Show the device as STALE when no telemetry has arrived for this many seconds.
VITE_FIREBASE_STALE_AFTER_SEC=30

# ── Write gateway (server-only secrets; do NOT prefix these with VITE_) ───────
PORT=8787
FIREBASE_DATABASE_URL=https://dropsafe-5cd7c-default-rtdb.asia-southeast1.firebasedatabase.app

# Preferred: path to the Firebase service-account JSON (never commit it).
FIREBASE_SERVICE_ACCOUNT_PATH=./server/service-account.json
# Alternative for hosts that only allow env vars. Paste the JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Device identity and credential. Generate with: npm run device-token
# Only the SHA-256 hash goes here; the raw token goes in the ESP32 secrets.h.
DEVICE_ID=dropsafe-01
DEVICE_TOKEN_SHA256=

# Monitoring configuration shared by the gateway and firmware. Keep these aligned
# with the ESP32 config.h and the dashboard Settings page.
BAG_ID=IV-01
LOW_ML=100
CRITICAL_ML=25
INITIAL_VOLUME_ML=500
EMPTY_BAG_TARE_G=30
FLUID_DENSITY_G_PER_ML=1.005
MAX_LOAD_G=5000

# Gateway hardening
ALLOWED_ORIGINS=http://localhost:5173
MIN_WRITE_INTERVAL_MS=1000
MAX_HISTORY_POINTS=500
# Set true in production when the gateway is behind an HTTPS reverse proxy.
REQUIRE_HTTPS=false
